{
  "name": "@food-mapper/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^8.0.4",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps --import dotenv/config --import ts-node/esm ./src/index.ts",
    "build": "tsc --build",
    "start": "node --import dotenv/config --enable-source-maps ./dist/index.js",
    "lint": "eslint .",
    "db:migrate": "node --import dotenv/config ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations up",
    "db:migrate:down": "node --import dotenv/config ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations down",
    "db:migrate:create": "node --import dotenv/config ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations create"
  },
  "dependencies": {
    "@food-mapper/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  }
}
